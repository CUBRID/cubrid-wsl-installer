<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <Binary Id="CUBRID_Background" SourceFile="..\resources\dialog.png" />
        <Binary Id="CUBRID_Banner" SourceFile="..\resources\banner.png" />

        <UI Id="CUBRIDWSLUI">
            <DialogRef Id="FilesInUse" />
            <Property Id="ARPPRODUCTICON" Value="icon.ico" />
            <Property Id="ARPCONTACT" Value="CUBRID" />
            <Property Id="ARPHELPLINK" Value="https://www.cubrid.org" />
            <Property Id="ARPURLINFOABOUT" Value="https://www.cubrid.org" />
            <Property Id="ErrorDialog" Value="CustomErrorDlg" />

            <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="13" />
            <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="10" Bold="yes" />
            
            <Error Id="30000">!(loc.CUBRID_Error_Feature_Timeout_Description)</Error>

            <Publish Dialog="CustomWelcomeDlg" Control="Next" Event="NewDialog" Value="CustomLicenseAgreementDlg">1</Publish>

            <InstallUISequence>
                <Custom Action="ActionEnvironmentCheck" Before="CustomWelcomeDlg" />
                
                <Show Dialog="VirtWarnDlg" After="ActionEnvironmentCheck">NOT CUB_BIOS_VIRT_ENABLED OR CUB_BIOS_VIRT_ENABLED="0"</Show>
                <Show Dialog="WindowsVersionWarnDlg" After="ActionEnvironmentCheck">NOT CUB_WINDOWS_VERSION_OK OR CUB_WINDOWS_VERSION_OK="0"</Show>
                <Show Dialog="AdminRightsWarnDlg" After="ActionEnvironmentCheck">NOT CUB_ADMIN_RIGHTS_GRANTED OR CUB_ADMIN_RIGHTS_GRANTED="0"</Show>
                <Show Dialog="WSLNotInstalledWarnDlg" After="ActionEnvironmentCheck">NOT CUB_WSL_INSTALLED OR CUB_WSL_INSTALLED="0"</Show>
                <Show Dialog="WSLRebootRequiredWarnDlg" After="ActionEnvironmentCheck">NOT CUB_WSL_REBOOT_REQUIRED OR CUB_WSL_REBOOT_REQUIRED="1"</Show>
                
                <Show Dialog="CustomWelcomeDlg" After="MigrateFeatureStates"/>

                <Show Dialog="CustomFatalErrorDlg" OnExit="error"/>
                <Show Dialog="CustomFinishDlg" OnExit="success"/>
                <Show Dialog="CustomUserExit" OnExit="cancel"/>
            </InstallUISequence>

            <AdminUISequence>
                <Show Dialog="CustomFatalErrorDlg" OnExit="error"/>
                <Show Dialog="CustomUserExit" OnExit="cancel" />
                <Show Dialog="CustomFinishDlg" OnExit="success" />
            </AdminUISequence>

            <Dialog Id="CustomWaitDialog" Width="370" Height="270" Title="!(loc.CUBRID_Wait_WindowTitle)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="320" Height="10" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_Wait_Description)" />
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="CustomWelcomeDlg" Width="370" Height="270" Title="!(loc.CUBRID_Welcome_WindowTitle)">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Next)">
                    <Publish Event="NewDialog" Value="CustomLicenseAgreementDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg"/>
                </Control>
                <Control Id="Title" Type="Text" X="135" Y="25" Width="220" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.CUBRID_Welcome_WindowTitle)" />
                <Control Id="Description" Type="Text" X="135" Y="50" Width="220" Height="120" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_Welcome_Description)" />
                <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="370" Height="233" TabSkip="yes" Text="CUBRID_Background" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="CustomLicenseAgreementDlg" Width="370" Height="270" Title="!(loc.CUBRID_License_WindowTitle)">
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.CUBRID_Back)">
                    <Publish Event="NewDialog" Value="CustomWelcomeDlg" />
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Next)">
                    <Condition Action="disable">CUBRID_EULA_OK &lt;&gt; "1"</Condition>
                    <Condition Action="enable">CUBRID_EULA_OK = "1"</Condition>
                    <Publish Event="NewDialog" Value="EnvironmentCheckDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg"/>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_License_Description)" />
                <Control Id="LicenseText" Type="ScrollableText" X="25" Y="45" Width="320" Height="150" Sunken="yes">
                    <Text SourceFile="..\resources\license.rtf" />
                </Control>
                <Control Id="CUBRID_LicenseAccepted" Type="CheckBox" X="25" Y="200" Width="320" Height="18" Property="CUBRID_EULA_OK" CheckBoxValue="1" Text="!(loc.CUBRID_License_CheckboxText)" />
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="EnvironmentCheckDlg" Width="370" Height="270" Title="!(loc.CUBRID_Env_WindowTitle)">
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.CUBRID_Back)">
                    <Publish Event="NewDialog" Value="CustomLicenseAgreementDlg" />
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Next)">
                    <Publish Event="NewDialog" Value="InstallOptionsDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg" />
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_Env_Description)" />
                <Control Id="EnvironmentCheckOutput" Type="Edit" X="25" Y="50" Width="320" Height="160" 
                         Sunken="yes" TabSkip="no" Multiline="yes" Property="CUB_ENVIRONMENT_CHECK_OUTPUT">
                </Control>
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="InstallOptionsDlg" Width="370" Height="270" Title="!(loc.CUBRID_InstallOptions_WindowTitle)">
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.CUBRID_Back)">
                    <Publish Event="NewDialog" Value="EnvironmentCheckDlg" />
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Next)">
                    <Publish Event="DoAction" Value="ActionUpdateInstallFolder" Order="1">1</Publish>
                    <Publish Event="DoAction" Value="ActionCheckWslName" Order="2">1</Publish>
                    <Publish Event="SpawnDialog" Value="CustomValidWslDlg" Order="3">CUB_WSL_NAME_VALID = "0"</Publish>
                    <Publish Event="NewDialog" Value="InstallSelectDirDlg" Order="4">CUB_WSL_NAME_VALID = "1"</Publish>

                    <Condition Action="disable">CUB_DEFAULT_WSL_NAME = ""</Condition>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg"/>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_InstallOptions_Description)" />
                
                <Control Id="DefaultWSLNameLabel" Type="Text" X="25" Y="52" Width="50" Height="17" Text="!(loc.CUBRID_InstallOptions_Default_WSL_Name_Label)" />
                <Control Id="DefaultWSLNameEdit" Type="Edit" X="75" Y="50" Width="200" Height="17" Property="CUB_DEFAULT_WSL_NAME" />
                <Control Id="RegisterTrayCheck" Type="CheckBox" X="25" Y="80" Width="10" Height="12" Property="REG_TRAY_APP" CheckBoxValue="1" Text=" " />
                <Control Id="RegisterTrayText" Type="Text" X="40" Y="80" Width="260" Height="12" Transparent="yes" Text="!(loc.CUBRID_Finish_RegisterTrayCheckbox)" />
                <Control Id="CreateShortcutCheck" Type="CheckBox" X="25" Y="95" Width="10" Height="12" Property="CREATE_SHORTCUT" CheckBoxValue="1" Text=" " />
                <Control Id="CreateShortcutText" Type="Text" X="40" Y="95" Width="260" Height="12" Transparent="yes" Text="!(loc.CUBRID_Finish_CreateShortcutCheckbox)" />
                <Control Id="CreateDemodbCheck" Type="CheckBox" X="25" Y="110" Width="10" Height="12" Property="CREATE_DEMODB" CheckBoxValue="1" Text=" " />
                <Control Id="CreateDemodbText" Type="Text" X="40" Y="110" Width="260" Height="12" Transparent="yes" Text="!(loc.CUBRID_Finish_CreateDemodbCheckbox)" />
                <Control Id="ISWSL2ModeCheck" Type="CheckBox" X="25" Y="125" Width="10" Height="12" Property="IS_WSL2_MODE" CheckBoxValue="1" Text=" " />
                <Control Id="ISWSL2ModeText" Type="Text" X="40" Y="125" Width="260" Height="12" Transparent="yes" Text="!(loc.CUBRID_Finish_WSL2ModeCheckbox)" />

                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="InstallSelectDirDlg" Width="370" Height="270" Title="!(loc.CUBRID_InstallDir_WindowTitle)">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Next)">
                    <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
                    <Publish Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
                    <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
                    <Publish Event="NewDialog" Value="CustomVerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.CUBRID_Back)">
                    <Publish Event="NewDialog" Value="InstallOptionsDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg" />
                </Control>

                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_InstallDir_Description)" />
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="15" NoPrefix="yes" Text="!(loc.CUBRID_InstallDir_FolderLabel)" />
                <Control Id="Folder" Type="PathEdit" X="20" Y="75" Width="320" Height="17" Property="WIXUI_INSTALLDIR" Indirect="yes" />
                <Control Id="ChangeFolder" Type="PushButton" X="20" Y="95" Width="56" Height="17" Text="!(loc.CUBRID_InstallDir_Change)" >
                    <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
                    <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
                </Control>
            </Dialog>

            <Dialog Id="CustomVerifyReadyDlg" Width="370" Height="270" Title="!(loc.CUBRID_VerifyReadyDlg_Title)">
                <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Install)">
                    <Publish Event="EndDialog" Value="Return" />
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.CUBRID_Back)">
                    <Publish Event="NewDialog" Value="InstallSelectDirDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_Cancel)">
                    <Publish Event="SpawnDialog" Value="CustomCancelDlg" />
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="60" Width="320" Height="120" Transparent="yes" Text="!(loc.CUBRID_VerifyReadyDlg_Description)" />
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>

            <Dialog Id="VirtWarnDlg" Width="370" Height="160" Title="!(loc.CUBRID_Check_Virt_Title)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="320" Height="60" TabSkip="no" Text="!(loc.CUBRID_Check_Virt_Description)" />
                <Control Id="OK" Type="PushButton" X="157" Y="110" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
            </Dialog>
            <Dialog Id="WindowsVersionWarnDlg" Width="370" Height="160" Title="!(loc.CUBRID_Check_WindowsVersion_Title)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="320" Height="60" TabSkip="no" Text="!(loc.CUBRID_Check_WindowsVersion_Description)" />
                <Control Id="OK" Type="PushButton" X="157" Y="110" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
            </Dialog>
            <Dialog Id="WSLNotInstalledWarnDlg" Width="370" Height="180" Title="!(loc.CUBRID_Check_WSLInstalled_Title)">
                <Control Id="Description" Type="Hyperlink" X="25" Y="20" Width="320" Height="120" TabSkip="no" Text="!(loc.CUBRID_Check_WSLInstalled_Description)" />
                <Control Id="OK" Type="PushButton" X="157" Y="150" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
            </Dialog>
            <Dialog Id="WSLRebootRequiredWarnDlg" Width="370" Height="160" Title="!(loc.CUBRID_Check_WSLRebootRequired_Title)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="320" Height="60" TabSkip="no" Text="!(loc.CUBRID_Check_WSLRebootRequired_Description)" />
                <Control Id="OK" Type="PushButton" X="157" Y="110" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Return" />
                </Control>
            </Dialog>
            <Dialog Id="AdminRightsWarnDlg" Width="370" Height="160" Title="!(loc.CUBRID_Check_AdminRights_Title)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="320" Height="60" TabSkip="no" Text="!(loc.CUBRID_Check_AdminRights_Description)" />
                <Control Id="OK" Type="PushButton" X="157" Y="110" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
            </Dialog>
            <Dialog Id="CustomCancelDlg" Width="260" Height="120" Title="!(loc.CUBRID_CustomCancelDlg_Header)" >
                <Control Id="Description" Type="Text" X="25" Y="20" Width="200" Height="40" Text="!(loc.CUBRID_CustomCancelDlg_Description)"/>
                <Control Id="YES" Type="PushButton" X="130" Y="100" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Yes)">
                    <Publish Event="EndDialog" Value="Exit"/>
                </Control>
                <Control Id="NO" Type="PushButton" X="190" Y="100" Width="56" Height="17" Cancel="yes" Text="!(loc.CUBRID_No)">
                    <Publish Event="EndDialog" Value="Return"/>
                </Control>
                <Control Id="BottomLine" Type="Line" X="0" Y="90" Width="260" Height="0" />
            </Dialog>
            <Dialog Id="CustomValidWslDlg" Width="300" Height="150" Title="!(loc.CUBRID_CustomValidWslDlg_Title)">
                <Control Id="Description" Type="Text" X="25" Y="20" Width="250" Height="80" NoPrefix="yes" Text="!(loc.CUBRID_CustomValidWslDlg_Description)" />
                <Control Id="OK" Type="PushButton" X="182" Y="125" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
                <Control Id="BottomLine" Type="Line" X="0" Y="115" Width="300" Height="0" />
            </Dialog>
            <Dialog Id="CustomUserExit" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Finish)">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
                <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="370" Height="233" TabSkip="yes" Text="CUBRID_Background" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="135" Y="50" Width="220" Height="233" Transparent="yes" Text="!(loc.CUBRID_UserExit_Text)" />
            </Dialog>
            <Dialog Id="CustomFinishDlg" Width="370" Height="270" Title="!(loc.CUBRID_Finish_Title)">
                <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.CUBRID_Finish)">
                    <Publish Event="DoAction" Value="ActionCreateDemodb"><![CDATA[CREATE_DEMODB = 1]]></Publish>
                    <Publish Event="DoAction" Value="ActionRegisterTrayApp"><![CDATA[REG_TRAY_APP = 1]]></Publish>
                    <Publish Event="DoAction" Value="ActionCreateShortcut"><![CDATA[CREATE_SHORTCUT = 1]]></Publish>
                    <Publish Event="DoAction" Value="ActionLaunchTrayApp"><![CDATA[START_TRAY_APP = 1]]></Publish>
                    <Publish Event="DoAction" Value="ActionStartCubridService">1</Publish>
                    <Publish Event="DoAction" Value="ActionUpdateInstalledSize">1</Publish>
                    <Publish Event="EndDialog" Value="Return"><![CDATA[1]]></Publish>
                </Control>
                <Control Id="Description" Type="Text" X="125" Y="23" Width="235" Height="12" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_Finish_Description)" />
                <Control Id="FinishText" Type="Text" X="125" Y="40" Width="235" Height="60" Transparent="yes" Text="!(loc.CUBRID_Finish_Text)" />
                <Control Id="StartTrayCheck" Type="CheckBox" X="125" Y="95" Width="10" Height="12" Property="START_TRAY_APP" CheckBoxValue="1" Text=" " />
                <Control Id="StartTrayText" Type="Text" X="140" Y="95" Width="200" Height="12" Transparent="yes" Text="!(loc.CUBRID_Finish_StartTrayCheckbox)" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
            </Dialog>
            <Dialog Id="CustomFatalErrorDlg" Width="370" Height="270" Title="!(loc.FatalError_Title)">
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
                    <Publish Event="EndDialog" Value="Exit">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.FatalErrorBitmap)" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.FatalErrorTitle)" />
                <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="140" Transparent="yes" NoPrefix="yes" Text="!(loc.CUBRID_FatalErrorDescription1) !(loc.FatalErrorDescription2)" />
            </Dialog>
            <Dialog Id="CustomErrorDlg" Width="370" Height="180" Title="!(loc.ErrorDlg_Title)" ErrorDialog="yes">
                <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="305" Height="120" TabSkip="no" NoPrefix="yes" Text="!(loc.ErrorDlgErrorText)" />
                <Control Id="Y" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUIYes)">
                    <Publish Event="EndDialog" Value="ErrorYes">1</Publish>
                </Control>
                <Control Id="A" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="EndDialog" Value="ErrorAbort">1</Publish>
                </Control>
                <Control Id="C" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="EndDialog" Value="ErrorCancel">1</Publish>
                </Control>
                <Control Id="ErrorIcon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="!(loc.ErrorDlgErrorIconTooltip)" FixedSize="yes" IconSize="32" Text="!(loc.ErrorDlgErrorIcon)" />
                <Control Id="I" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUIIgnore)">
                    <Publish Event="EndDialog" Value="ErrorIgnore">1</Publish>
                </Control>
                <Control Id="N" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUINo)">
                    <Publish Event="EndDialog" Value="ErrorNo">1</Publish>
                </Control>
                <Control Id="O" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUIOK)">
                    <Publish Event="EndDialog" Value="ErrorOk">1</Publish>
                </Control>
                <Control Id="R" Type="PushButton" X="157" Y="153" Width="56" Height="17" TabSkip="yes" Text="!(loc.WixUIRetry)">
                    <Publish Event="EndDialog" Value="ErrorRetry">1</Publish>
                </Control>
            </Dialog>
        </UI>
    </Fragment>
</Wix>
