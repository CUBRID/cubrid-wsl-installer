<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-kr" Language="1042" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    
    <!-- Application Title -->
    <String Id="Caption">[WixBundleName] 설치</String>
    <String Id="Title">CUBRID For WSL 설치 프로그램</String>
    
    <!-- Welcome/Install Page -->
    <String Id="InstallHeader">CUBRID For WSL 설치</String>
    <String Id="InstallMessage">CUBRID For WSL을 설치합니다.</String>
    <String Id="InstallDescription"> 본 프로그램은 Microsoft에서 제공하는 &lt;a href="https://github.com/microsoft/WSL"&gt;WSL(Windows Subsystem for Linux)&lt;/a&gt;환경에서 CUBRID가 설치된 배포판을 설치 합니다.&#13;&#10;설치 과정에서 WSL 실행 환경을 검증하고 CUBRID가 설치된 배포판 및 Tray 애플리케이션을 설치합니다.&#13;&#10;Tray 애플리케이션을 통해 CUBRID를 제어 할 수 있습니다.</String>
    <String Id="InstallVersion">버전 [WixBundleVersion]</String>
    <String Id="ConfirmCancelMessage">취소하시겠습니까?</String>
    
    <!-- Buttons -->
    <String Id="InstallInstallButton">설치(&amp;I)</String>
    <String Id="InstallCloseButton">닫기(&amp;C)</String>
    
    <!-- Progress Page -->
    <String Id="ProgressHeader">진행 중</String>
    <String Id="ProgressLabel">진행 중</String>
    <String Id="OverallProgressPackageText">초기화 중: [WixBundleName]</String>
    <String Id="ProgressCancelButton">취소(&amp;C)</String>
    
    <!-- Modify Page -->
    <String Id="ModifyHeader">제거 안내</String>
    <String Id="ModifyMessage">제거시 설치된 WSL 배포판도 삭제되므로 계속 사용이 필요 할 경우 WSL 배포판을 백업하세요.&#13;&#10;설치된 앱을 제거 하시려면 제거 버튼을 클릭해주세요.</String>
    <String Id="ModifyUninstallButton">제거(&amp;U)</String>
    <String Id="ModifyCloseButton">닫기(&amp;C)</String>
    
    <!-- Success Page -->
    <String Id="SuccessHeader">완료</String>
    <String Id="SuccessInstallHeader">설치 완료</String>
    <String Id="SuccessRepairHeader">복구 완료</String>
    <String Id="SuccessUninstallHeader">제거 완료</String>
    <String Id="SuccessMessage">설치가 완료되었습니다.</String>
    <String Id="SuccessRepairMessage">복구가 완료되었습니다.</String>
    <String Id="SuccessUninstallMessage">제거가 완료되었습니다.</String>
    <String Id="SuccessLaunchButton">완료</String>
    <String Id="SuccessRestartText">일부 변경 사항을 적용하려면 컴퓨터를 다시 시작해야 합니다.</String>
    <String Id="SuccessRestartButton">다시 시작(&amp;R)</String>
    <String Id="SuccessCloseButton">닫기(&amp;C)</String>
    
    <!-- Failure Page -->
    <String Id="FailureHeader">설치 실패</String>
    <String Id="FailureInstallHeader">설치 실패</String>
    <String Id="FailureUninstallHeader">제거 실패</String>
    <String Id="FailureRepairHeader">복구 실패</String>
    <String Id="FailureMessage">설치 중 오류가 발생했습니다.</String>
    <String Id="FailureHyperlinkLogText">자세한 내용은 &lt;a href="#"&gt;로그 파일&lt;/a&gt;을 확인하세요.</String>
    <String Id="FailureRestartText">일부 변경 사항을 적용하려면 컴퓨터를 다시 시작해야 합니다.</String>
    <String Id="FailureRestartButton">다시 시작(&amp;R)</String>
    <String Id="FailureCloseButton">닫기(&amp;C)</String>
    <String Id="FailureAlreadyInstalled">이미 설치되어 있습니다. 업그레이드/중복 설치를 지원하지 않습니다.&#13;&#10;설정(앱-설치된앱)에서 제거후 설치 해주세요.</String>
    
</WixLocalization>

